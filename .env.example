# Copy to .env; generate independent random secrets before starting.
DB_USER=codeforge
DB_NAME=codeforge
# Keep this aligned with PG_VERSION in an existing database volume. Do not upgrade by changing the image alone.
POSTGRES_VERSION=15
DB_PASSWORD=replace-with-random-database-password
REDIS_PASSWORD=replace-with-random-redis-password
DATABASE_URL=postgresql://codeforge:replace-with-random-database-password@localhost:5432/codeforge
REDIS_URL=redis://:replace-with-random-redis-password@localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-different-random-characters-refresh
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# false only for local HTTP; true for production HTTPS
COOKIE_SECURE=false
# Required: trusted isolated Judge0 deployment, not a container on the app host.
JUDGE0_URL=http://host.docker.internal:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_PYTHON_ID=71
EXECUTION_TIMEOUT_MS=60000
MAX_SOURCE_BYTES=65536
MAX_OUTPUT_BYTES=65536
MAX_USER_CONCURRENT_JOBS=2
WORKER_CONCURRENCY=2
GLOBAL_EXECUTION_CONCURRENCY=2
EXECUTIONS_PER_HOUR=30
LOG_LEVEL=info
SOURCE_RETENTION_DAYS=90
# Load missing original practice problems/courses on API startup; preserves existing content and accounts.
SEED_CONTENT_ON_START=true
# Optional social login. Register these exact callback URLs with the providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
# Optional AI tutor: both a server-side key and a model available to your API project are required.
# Never use a VITE_ variable for the API key. Leave empty to disable the tutor.
OPENAI_API_KEY=
AI_MODEL=
AI_REQUESTS_PER_HOUR=20
AI_MAX_OUTPUT_TOKENS=1800
AI_TIMEOUT_MS=45000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# One-time bootstrap only; never commit the actual values.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional existing integrations
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
